{
  "name": "@agent-tokenomics/core",
  "version": "0.1.0",
  "description": "Vendor-neutral measurement contracts for LLMs, agents, harnesses, latency, cost, context and verified outcomes",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "homepage": "https://github.com/kvnloo/tokenomics#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kvnloo/tokenomics",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/kvnloo/tokenomics/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "observability",
    "opentelemetry",
    "token-usage",
    "evaluation"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
